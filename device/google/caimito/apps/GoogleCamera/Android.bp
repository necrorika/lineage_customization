android_app_import {
    name: "GoogleCamera",
    apk: "GoogleCamera.apk",
    presigned: true,
    preprocessed: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    product_specific: true,
    overrides: ["Camera2"],
}

prebuilt_etc {
    name: "privapp-permissions-google-camera",
    product_specific: true,
    sub_dir: "permissions",
    src: "privapp-permissions-google-camera.xml",
    filename_from_src: true,
}